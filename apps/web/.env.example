# MultiBaas deployment base URL (no trailing slash)
# MultiBaas のベース URL（末尾スラッシュなし）
VITE_MB_BASE_URL=

# MultiBaas API key (DApp User group)
# MultiBaas API キー（DApp User）
VITE_MB_API_KEY=

# Contracts created and linked in MultiBaas
# MultiBaas に登録・紐付け済みコントラクト
VITE_STABLECOIN_CONTRACT_LABEL=matsuri_stablecoin
VITE_STABLECOIN_ADDRESS_ALIAS=matsuri_stablecoin
VITE_VOUCHER_CONTRACT_LABEL=matsuri_voucher
VITE_VOUCHER_ADDRESS_ALIAS=matsuri_voucher

# Default wallet network preset (awaji or sepolia)
# デフォルトネットワーク（awaji または sepolia）
VITE_DEFAULT_CHAIN=awaji

# Optional Sepolia RPC override
# Sepolia RPC の上書き（任意）
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Agent API (agent/api.ts), server-side only. Upstash Redis for sign-ins and switches: run `vercel env pull` and copy these two.
# エージェント API（agent/api.ts）、サーバー側専用。サインインとスイッチを保存する Upstash Redis。`vercel env pull` を実行しこの2つをコピーする。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The HTTPS origin agents sign for: set to the live site's address in production (default https://matsuri.example).
# エージェントが署名する HTTPS オリジン。本番ではサイトのアドレスを設定する（既定値 https://matsuri.example）。
# AGENT_AUDIENCE=https://matsuri-stablecoin.vercel.app

# Example Origin for CORS: http://localhost:5173 (window.location.origin)
# CORS に追加する Origin 例: http://localhost:5173（window.location.origin）
