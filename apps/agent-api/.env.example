# Matsuri agent API. Copy to .env (git-ignored). Server-side only.
# Matsuri エージェント API。.env にコピー（Git 管理外）。サーバー側専用。

# Sepolia JSON-RPC used to verify agent accounts. (MultiBaas offers JSON-RPC only on Curvegrid Testnet.)
# エージェントのアカウント検証に使う Sepolia JSON-RPC（MultiBaas の JSON-RPC は Curvegrid Testnet のみ）。
AGENT_API_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AGENT_API_CHAIN_ID=11155111

# The Agentic World account implementation Matsuri trusts: the official Sepolia deployment (eth-tokyo-2026 sdk/deployments.ts).
# Matsuri が信頼する Agentic World アカウントの実装。Sepolia の公式デプロイ（eth-tokyo-2026 の sdk/deployments.ts）。
AGENT_API_IMPLEMENTATION=0xd08B955ca8727d86e708ae5684D5fa7f32635e66

# Canonical HTTPS origin agents sign for. Locally the server listens on loopback HTTP only.
# エージェントが署名する正規の HTTPS オリジン。ローカルではループバックの HTTP のみで待ち受ける。
AGENT_API_AUDIENCE=https://matsuri.example
AGENT_API_PORT=4200

# The web app origin allowed to call the owner endpoints (the Agent Access panel).
# 所有者用エンドポイント（エージェントのアクセス画面）を呼べる Web アプリのオリジン。
AGENT_API_WEB_ORIGIN=http://localhost:5173

# Matsuri's own MultiBaas credentials (a DApp User key is enough). Agents never see these.
# Matsuri 自身の MultiBaas 認証情報（DApp User キーで十分）。エージェントには渡らない。
MB_BASE_URL=
MB_API_KEY=

# Deployed Matsuri contracts (contracts/ignition/deployments/chain-11155111/deployed_addresses.json).
# デプロイ済みの Matsuri コントラクト（contracts/ignition/deployments/chain-11155111/deployed_addresses.json）。
MATSURI_STABLECOIN=0x3fb99cEB40FB5d80D2070e6300E17fCcc4e7E9DF
MATSURI_VOUCHER=0x3d1374e8577b4A7E1e06517FE0fc42F2d58DC0cB
